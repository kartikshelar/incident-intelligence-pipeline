FROM python:3.12-slim

WORKDIR /srv

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 gcc \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY app ./app
COPY migrations ./migrations
COPY tests ./tests
COPY spike ./spike
COPY alembic.ini ./

RUN pip install --no-cache-dir -e ".[dev]"

CMD ["pytest", "-v"]
