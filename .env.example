# Copy to .env (git-ignored). Read by app.settings and by docker compose.

# LLM provider and model for extraction. No defaults exist in code; these
# are the project's chosen defaults.
APP_LLM_PROVIDER=anthropic
APP_EXTRACTION_MODEL=claude-sonnet-5

# Thinking/effort, interpreted by the provider (app/extract/llm.py) and
# stored verbatim on every extractions row. For anthropic: default |
# adaptive | disabled, optionally ":<low|medium|high|xhigh|max>", e.g.
# adaptive:low. `default` sends nothing and lets the API decide.
APP_EXTRACTION_THINKING=default

# Key for the provider above, under the SDK's own variable name.
ANTHROPIC_API_KEY=

# Optional: APP_EXTRACTION_MAX_TOKENS=16000, APP_EXTRACTION_MAX_ATTEMPTS=3
