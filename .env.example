# Copy to .env (git-ignored). Read by app.settings and by docker compose.

# LLM provider and model for extraction. No defaults exist in code; these
# are the project's chosen defaults.
APP_LLM_PROVIDER=anthropic
APP_EXTRACTION_MODEL=claude-sonnet-5

# Thinking/effort, interpreted by the provider (app/extract/llm.py) and
# stored verbatim on every extractions row. For anthropic: default |
# adaptive | disabled, optionally ":<low|medium|high|xhigh|max>", e.g.
# adaptive:low. `default` sends nothing and lets the API decide.
#
# adaptive:low since 2026-09-16 (runs 05-07, app/extract/schema.py
# changelog): about half the output tokens of `default` on the same 10
# documents. `disabled` is cheaper still but collapsed trigger and
# mechanism into one on the AWS latent-defect case.
APP_EXTRACTION_THINKING=adaptive:low

# Optional. Labels which run a row belongs to (ADR-006 §8 needs two
# independent runs at identical settings to be distinguishable). Unset
# means each worker process generates its own UUID (app/extract/llm.py) —
# enough to make one `python -m scripts.extraction_run` invocation its own
# run. Set this to share one run id across multiple worker processes.
# APP_EXTRACTION_RUN_ID=

# Key for the provider above, under the SDK's own variable name.
ANTHROPIC_API_KEY=

# Optional: APP_EXTRACTION_MAX_TOKENS=16000, APP_EXTRACTION_MAX_ATTEMPTS=3

# Review routing (M4, ADR-010). A field whose self-reported confidence is
# below the floor is eligible for human review; eligible fields are ranked
# lowest-confidence first. 0.70 is ADR-010 §3's provisional operating
# point — it is configuration, not a constant, because M5 sweeps it
# against the gold set. Do not tune it by hand before then.
APP_REVIEW_CONFIDENCE_FLOOR=0.70
# Optional cap on how many fields may be awaiting a reviewer at once,
# applied after ranking. Unset = uncapped (how M5 evaluates the policy).
# APP_REVIEW_BUDGET=

# M6 tracing (app/telemetry/tracing.py). "console" prints spans to stdout
# and needs no collector; "otlp" sends to APP_OTEL_EXPORTER_ENDPOINT.
APP_OTEL_EXPORTER=console
# APP_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces

# M6 cost per document (app/telemetry/cost.py): same convention as
# scripts/extraction_run.py. All four must be set or cost is reported as
# null on /metrics and /cost, never guessed.
# PRICE_INPUT_USD_PER_MTOK=
# PRICE_OUTPUT_USD_PER_MTOK=
# PRICE_CACHE_READ_USD_PER_MTOK=
# PRICE_CACHE_WRITE_USD_PER_MTOK=

# M6 part 2 (app/api/auth.py): HTTP Basic Auth on /review/* and
# /ui/review/* — the endpoints that write gold-set data. Unset (the local
# default) means the gate is not engaged, so `docker compose up` needs no
# credentials. Set both to require a login; the deployed instance
# (render.yaml) always sets both.
# APP_REVIEW_BASIC_AUTH_USER=
# APP_REVIEW_BASIC_AUTH_PASS=
