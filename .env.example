# Copy to .env (git-ignored). Read by app.settings and by docker compose.

# LLM provider and model for extraction. No defaults exist in code; these
# are the project's chosen defaults.
APP_LLM_PROVIDER=anthropic
APP_EXTRACTION_MODEL=claude-sonnet-5

# Thinking/effort, interpreted by the provider (app/extract/llm.py) and
# stored verbatim on every extractions row. For anthropic: default |
# adaptive | disabled, optionally ":<low|medium|high|xhigh|max>", e.g.
# adaptive:low. `default` sends nothing and lets the API decide.
#
# adaptive:low since 2026-09-16 (runs 05-07, app/extract/schema.py
# changelog): about half the output tokens of `default` on the same 10
# documents. `disabled` is cheaper still but collapsed trigger and
# mechanism into one on the AWS latent-defect case.
APP_EXTRACTION_THINKING=adaptive:low

# Optional. Labels which run a row belongs to (ADR-006 §8 needs two
# independent runs at identical settings to be distinguishable). Unset
# means each worker process generates its own UUID (app/extract/llm.py) —
# enough to make one `python -m scripts.extraction_run` invocation its own
# run. Set this to share one run id across multiple worker processes.
# APP_EXTRACTION_RUN_ID=

# Key for the provider above, under the SDK's own variable name.
ANTHROPIC_API_KEY=

# Optional: APP_EXTRACTION_MAX_TOKENS=16000, APP_EXTRACTION_MAX_ATTEMPTS=3
